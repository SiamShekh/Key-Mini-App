generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            Int       @id @default(autoincrement())
  name          String
  username      String?
  tgId          String    @unique
  balance       Int       @default(0)
  referBy       String?
  referCode     String
  publicKey     String?
  joinedAt      DateTime  @default(now())
  lastSeenAt    DateTime?
  isIntroShowed Boolean   @default(false)
  isBlock       Boolean   @default(false)
  isDelete      Boolean   @default(false)
}

enum taskCategory {
  telegram
  twitter
  youtube
  facebook
  others
}

model task {
  id        Int          @id @default(autoincrement())
  title     String
  link      String
  category  taskCategory
  bgImage   String
  isDelete  Boolean      @default(false)
  isPause   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model completedTask {
  userId Int
  taskId Int

  createdAt DateTime @default(now())

  @@id([userId, taskId])
}
